function main() {
    var matrix_x = [
        [1, 1],
        [2, 2]
    ];
    var matrix_y = [
        [2, 2],
        [3, 3]
    ];

    var y = 0;
    while (y < len(matrix_x)) {
        var x = 0;
        var row = ""; // for pretty print hehe
        while (x < len(matrix_y[0])) {
             row = row + (matrix_x[x][y] + matrix_y[x][y]) + " ";
             x = x + 1;
        }
        print("[ " + row + "]");
        y = y + 1;
    }
    return;
}